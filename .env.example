# MongoDB connection (replica set recommended in production)
MONGODB_URI=mongodb://127.0.0.1:27017/gst_return_desk

# 32+ random chars – signs app login cookies
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# AES-256-GCM keys "keyId:base64(32 bytes)", first one encrypts. Required for GST_INTEGRATION=sandbox
# (encrypts the GST taxpayer access token and username per company).
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# DATA_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES

# Super admin console (/admin): packages, licenses, customers. This account is created from these
# values the first time you sign in at /admin/login; after that change email/password in the console
# (My account). Forgot it? Set SUPER_ADMIN_RESET=true, sign in with SUPER_ADMIN_PASSWORD, then remove the flag.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-strong-password
# SUPER_ADMIN_RESET=true

# Allow creating additional organisations from /register after the first one
ALLOW_SIGNUP=false

# GST portal step.
#   manual  = user signs in and uploads on the official GST portal; the app records evidence.
#   sandbox = file GSTR-1 from inside the app through the Sandbox.co.in GST Compliance API (authorised GSP).
GST_INTEGRATION=manual
GST_PORTAL_URL=https://www.gst.gov.in/

# Sandbox.co.in API (filing needs GST_INTEGRATION=sandbox; the Validators page uses these keys for
# GSTIN lookups in any mode). Keys must match the base URL:
#   key_test_… / secret_test_…  →  https://test-api.sandbox.co.in   (test environment)
#   key_live_… / secret_live_…  →  https://api.sandbox.co.in        (LIVE – files real returns)
# SANDBOX_API_KEY=key_test_xxxxxxxx
# SANDBOX_API_SECRET=secret_test_xxxxxxxx
# SANDBOX_API_BASE=https://test-api.sandbox.co.in

# Client documents: reading PDFs, scans, photos and Word files with Claude (Excel/CSV/GSTN JSON need no key).
ANTHROPIC_API_KEY=
# Optional: model (default claude-opus-5-5), effort (low | medium | high; default medium), documents read at once (default 3).
# DOC_AI_MODEL=claude-opus-5-5
# DOC_AI_EFFORT=medium
# DOC_AI_CONCURRENCY=3
# Optional: the "Ask the documents" assistant (uses ANTHROPIC_API_KEY): model and effort (default medium).
# ASSISTANT_MODEL=claude-opus-5-5
# ASSISTANT_EFFORT=medium
# Optional: exchange rate used to price Claude API usage in ₹ for the Document AI allowance (default 85).
# USD_INR=85
